.guard_index/

# Exception (documented and intentional): the ACBrMonitor installer is REQUIRED
# in the public release. Without it the client cannot emit fiscal documents.
# Only these exact paths are re-included; every other .exe stays ignored.
!instala/ACBrMonitorPLUS-DEMO-1.4.0.467-x86-I.exe
!_build_support/acbr/ACBrMonitor_Installer.exe

# Runtime-generated ACBrMonitor.ini: written on the dev machine and contains
# absolute local paths (APPDATA). The real config lives next to the installed
# ACBrMonitor.exe; this copy must never be committed.
instala/ACBrMonitor.ini
acbrmonitor/ACBrMonitor.ini

# Local scratch/audit output from development sessions
_tmp_*
_out_*.txt
_r[0-9].txt
_saida_*.txt
_CORRECAO_*.txt
_git_*.txt
stdout.txt
